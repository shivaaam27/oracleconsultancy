{
  "regions": [
    "dub1"
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/snapshots",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/email",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reindex",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/auto-sort",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/morning-run",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ori-digest",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/ori-automations",
      "schedule": "0 6 * * *"
    }
  ]
}
