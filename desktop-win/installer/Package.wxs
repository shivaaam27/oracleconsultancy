<?xml version="1.0" encoding="utf-8"?>
<!--
  The installer.

  ⚠️ IT INSTALLS A FOLDER, NOT A SINGLE FILE, AND THAT IS THE WHOLE POINT.
  Windows Smart App Control BLOCKS a `PublishSingleFile` build outright — a
  self-extracting compressed executable is the shape of a malware dropper, and
  SAC refuses it wherever it sits. The original ORI shell on this machine is also
  unsigned C# + WebView2 and runs perfectly well; the only difference is that it
  ships as ordinary files. Measured both ways on 20 Aug 2026: packed = blocked,
  unpacked = runs. Do not "tidy this up" back into one file.

  PER-USER on purpose (Scope="perUser"), which is the decision that matters here:
  it installs into the person's own AppData and needs NO administrator rights and
  no "do you want to allow this app to make changes" prompt. Staff without admin
  on their laptop can install it themselves. A per-machine install into Program
  Files would need IT for every single person.

  ⚠️ UpgradeCode must NEVER change. It is how Windows knows version 1.0.1 is the
  same product as 1.0.0 and should replace it rather than install alongside it.
  Change it and everyone ends up with two copies.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="Oracle Consultancy"
    Manufacturer="Oracle Consultancy Ltd"
    Version="1.0.0"
    UpgradeCode="885652E5-1A52-40D9-9039-0E821D089A5E"
    Scope="perUser"
    Compressed="yes">

    <!-- Installing a newer version removes the old one first. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Oracle Consultancy is already installed." />

    <!-- The app is embedded in the .msi, so there is ONE file to share. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="Assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://oracleconsultancy.vercel.app" />
    <!-- No "repair" button in Add/Remove Programs: reinstalling is the repair. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <Feature Id="Main" Title="Oracle Consultancy" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <!-- LocalAppData\Programs is where per-user apps belong on Windows; it is
         where VS Code and Teams put themselves for a per-user install. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Oracle Consultancy" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Oracle Consultancy" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Every file the app needs, harvested from the publish folder. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- ⚠️ This path is relative to THIS FILE, unlike SourceFile above which
           resolves from the build directory. WiX is inconsistent here. -->
      <Files Include="..\publish-folder\**" />
    </ComponentGroup>

    <!-- Shortcuts live in their own component with a registry key-path: a
         harvested file cannot serve as one. -->
    <ComponentGroup Id="AppShortcuts" Directory="INSTALLFOLDER">
      <Component Id="Shortcuts" Guid="C7A1F0B2-6D34-4E15-9C88-2F5B7E93A410">
        <RegistryValue Root="HKCU"
                       Key="Software\Oracle Consultancy Ltd\Oracle Consultancy"
                       Name="Installed" Type="integer" Value="1" KeyPath="yes" />

        <Shortcut Id="StartMenuShortcut" Directory="AppMenuFolder"
                  Name="Oracle Consultancy"
                  Description="The Oracle Consultancy administrator"
                  Target="[INSTALLFOLDER]Oracle Consultancy.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />

        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder"
                  Name="Oracle Consultancy"
                  Description="The Oracle Consultancy administrator"
                  Target="[INSTALLFOLDER]Oracle Consultancy.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />

        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
