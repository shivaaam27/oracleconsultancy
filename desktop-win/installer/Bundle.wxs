<?xml version="1.0" encoding="utf-8"?>
<!--
  The .exe wrapper around the .msi.

  Why bother, when the .msi installs perfectly well on its own? Because an .exe
  is what people expect to be handed, and because a bundle can later chain the
  WebView2 runtime installer for the rare Windows 10 machine that lacks it —
  which an .msi cannot do.

  Paths are relative to the BUILD directory (desktop-win). Run
  build-installer.cmd rather than calling wix by hand.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <Bundle
    Name="Oracle Consultancy"
    Version="1.0.0"
    Manufacturer="Oracle Consultancy Ltd"
    UpgradeCode="B2FB68E5-6E4E-4D8A-9C43-D1EDE6E42D33"
    IconSourceFile="Assets\icon.ico"
    AboutUrl="https://oracleconsultancy.vercel.app"
    Compressed="yes">

    <BootstrapperApplication>
      <!-- The plainest built-in window: a licence-free "Install" screen with a
           progress bar. No EULA to click through — this is an internal tool. -->
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl=""
        SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!-- ⚠️ The app is framework-dependent: 0.46 MB instead of 51 MB, because it
         uses the .NET already on the machine instead of carrying its own copy.
         The cost is that the machine must HAVE it.

         This does not install .NET — that needs administrator rights and would
         undo the whole point of a per-user install. It checks, and if it is
         missing it says so plainly with the address to get it, which is far
         better than the app being installed and then refusing to start with a
         message about a runtime nobody has heard of. -->
    <netfx:DotNetCoreSearch
      Id="DesktopRuntime"
      RuntimeType="desktop"
      Platform="x64"
      MajorVersion="8"
      Variable="DotNetDesktop8" />

    <bal:Condition Condition="DotNetDesktop8 &gt;= v8.0.0" Message="Oracle Consultancy needs the Microsoft .NET 8 Desktop Runtime (x64), which is not on this computer.&#xA;&#xA;Install it from https://dotnet.microsoft.com/download/dotnet/8.0 — choose &quot;Desktop Runtime x64&quot; — then run this setup again.&#xA;&#xA;It is a free Microsoft component and installing it needs an administrator." />

    <Chain>
      <MsiPackage
        SourceFile="installer\out\Oracle Consultancy Setup.msi"
        Vital="yes"
        Compressed="yes" />
    </Chain>
  </Bundle>
</Wix>
