<Window x:Class="OracleConsultancy.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Oracle Consultancy"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Colours are set in code, not here, so the panel follows the same theme
         the main window is wearing. A hard-coded white panel opening out of a
         dark app is the exact fault this release is fixing elsewhere. -->
    <Border x:Name="Root" Padding="20">
        <StackPanel>

            <TextBlock x:Name="AppName"
                       Text="Oracle Consultancy"
                       FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="Tagline"
                       Text="The Chief-of-Staff administrator, in a window."
                       FontSize="12" Margin="0,2,0,0" />

            <Border x:Name="Divider" Height="1" Margin="0,16,0,16" />

            <!-- What you have -->
            <TextBlock x:Name="YouHaveLabel" Text="YOU HAVE" FontSize="10" />
            <TextBlock x:Name="YouHave" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />

            <!-- What COS publishes -->
            <TextBlock x:Name="PublishedLabel" Text="COS PUBLISHES" FontSize="10" Margin="0,14,0,0" />
            <TextBlock x:Name="Published" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock x:Name="Checked" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />

            <!-- What changed, when there is anything to say -->
            <TextBlock x:Name="NotesLabel" Text="WHAT CHANGED" FontSize="10" Margin="0,14,0,0"
                       Visibility="Collapsed" />
            <ItemsControl x:Name="Notes" Margin="0,4,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="Divider2" Height="1" Margin="0,18,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyDiag" Content="Copy diagnostics"
                        Padding="12,5" Margin="0,0,8,0" Cursor="Hand"
                        Click="CopyDiag_Click" />
                <Button x:Name="CheckNow" Content="Check for updates"
                        Padding="12,5" Margin="0,0,8,0" Cursor="Hand"
                        Click="CheckNow_Click" />
                <Button x:Name="CloseBtn" Content="Close"
                        Padding="12,5" Cursor="Hand"
                        IsCancel="True" Click="CloseBtn_Click" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
