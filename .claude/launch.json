{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cos-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "cos-fast",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "studio-mockup",
      "runtimeExecutable": "python",
