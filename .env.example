# =============================================================================
# COS System — environment template
# Copy this to `.env.local` and fill in the real values. NEVER commit `.env.local`.
# The real values for the current setup are packed in COS-NEW-PC-TRANSFER/secrets/.
# See START_HERE_NEW_PC.md for what each key does and what breaks without it.
# =============================================================================

# --- Core database (REQUIRED — nothing runs without this) ---------------------
# Supabase connection pooler, port 6543. Keep prepare:false / max:1 in src/db/index.ts.
DATABASE_URL=
# Direct connection, port 5432 — used by migrations on Vercel deploys.
DIRECT_DATABASE_URL=

# --- Auth / secrets (REQUIRED for login) --------------------------------------
APP_PASSPHRASE=              # owner Command Centre login
PORTAL_SESSION_SECRET=       # staff portal cookie signing
CRON_SECRET=                 # protects /api/cron/* background jobs
INBOX_SECRET=                # document intake endpoint

# --- Supabase client / server -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # public client (search + realtime chat)
SUPABASE_SERVICE_ROLE_KEY=       # server-side (embeddings, indexing) — KEEP SECRET

# --- AI -----------------------------------------------------------------------
# Groq powers voice transcription + fallback text AI. The active key can also be
# set in-app (Settings → AI key), which overrides this and lives in the cloud DB.
GROQ_API_KEY=
# (Gemini vision/OCR key is normally stored in-app Settings, not here.)

# --- Google Calendar / Meet sync ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Gmail SMTP) -------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- WhatsApp (Twilio sandbox) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Error monitoring (Sentry — inert unless set) -----------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Web push notifications (VAPID) — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=               # e.g. mailto:admin@oracle.co.tz

# --- Deploy -------------------------------------------------------------------
VERCEL_TOKEN=                # for deploying to the live site from the CLI
