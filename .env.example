# =============================================================================
# Oracle — environment template
# Copy this to `.env.local` and fill in the real values. NEVER commit `.env.local`.
# See START_HERE_NEW_PC.md for what each key does and what breaks without it.
# =============================================================================

# --- Core database (REQUIRED — nothing runs without this) ---------------------
# Supabase connection pooler, port 6543. Keep prepare:false / max:1 in src/db/index.ts.
DATABASE_URL=
# Direct connection, port 5432 — used by migrations on Vercel deploys.
DIRECT_DATABASE_URL=

# --- Auth / secrets (REQUIRED) ------------------------------------------------
# The owner password itself is set in the app (Settings), not here.
PORTAL_SESSION_SECRET=       # signs the owner and staff sign-in cookies
CRON_SECRET=                 # protects /api/cron/* background jobs

# --- Supabase server ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only — KEEP SECRET

# --- AI -----------------------------------------------------------------------
# Gemini runs every AI feature. The key can also be set in-app (Settings → AI).
GEMINI_API_KEY=
# Groq is used ONLY for voice transcription (Whisper).
GROQ_API_KEY=

# --- Google Calendar / Meet sync ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Gmail SMTP) -------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- WhatsApp (Twilio) --------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Error monitoring (Sentry — inert unless set) -----------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Web push notifications (VAPID) — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=               # e.g. mailto:admin@oracle.co.tz

# --- Security headers ---------------------------------------------------------
CSP_ENFORCE=                 # 1 = enforce the CSP (build-time; needs a redeploy)

# --- Claude Code → Oracle (MCP) — written by `npm run mcp:key` ----------------
COS_MCP_KEY=
